    {"type": "text", "id": "flow_panel_header", "x": 58, "y": 292, "width": 380, "height": 18, "text": "flow.json, saved by the flow builder", "originalText": "flow.json, saved by the flow builder", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#94a3b8", "backgroundColor": "transparent", "roughness": 0, "containerId": null, "lineHeight": 1.25},
    {"type": "text", "id": "flow_panel_body", "x": 58, "y": 318, "width": 395, "height": 235, "text": "{ \"nodes\": [\n  { \"id\": \"ask_day\", \"type\": \"step\",\n    \"tools\": [\"find_free_days\"],\n    \"collect\": [\"day\"] },\n  { \"id\": \"book\", \"type\": \"http_tool\",\n    \"request\": \"POST /bookings\" },\n  { \"id\": \"done\", \"type\": \"end\",\n    \"outcome\": \"booked\" } ],\n  \"edges\": [\n  { \"from\": \"ask_day\", \"to\": \"book\",\n    \"when\": \"day collected\" },\n  { \"from\": \"book\", \"to\": \"done\" } ] }", "originalText": "{ \"nodes\": [\n  { \"id\": \"ask_day\", \"type\": \"step\",\n    \"tools\": [\"find_free_days\"],\n    \"collect\": [\"day\"] },\n  { \"id\": \"book\", \"type\": \"http_tool\",\n    \"request\": \"POST /bookings\" },\n  { \"id\": \"done\", \"type\": \"end\",\n    \"outcome\": \"booked\" } ],\n  \"edges\": [\n  { \"from\": \"ask_day\", \"to\": \"book\",\n    \"when\": \"day collected\" },\n  { \"from\": \"book\", \"to\": \"done\" } ] }", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "roughness": 0, "containerId": null, "lineHeight": 1.25},

