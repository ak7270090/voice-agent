    {"type": "text", "id": "title", "x": 20, "y": 10, "width": 1120, "height": 33, "text": "Voice Agent Studio: build in the console, run in the runtime, watch every call", "originalText": "Voice Agent Studio: build in the console, run in the runtime, watch every call", "fontSize": 26, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af", "backgroundColor": "transparent", "roughness": 1, "containerId": null, "lineHeight": 1.25},
    {"type": "text", "id": "subtitle", "x": 20, "y": 50, "width": 1180, "height": 20, "text": "The console saves agents and flows; the runtime fetches them at call start and serves phone and browser callers through LiveKit", "originalText": "The console saves agents and flows; the runtime fetches them at call start and serves phone and browser callers through LiveKit", "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "roughness": 1, "containerId": null, "lineHeight": 1.25},

