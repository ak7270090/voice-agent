# Copy to .env.local and fill in the keys. Docker Compose and every app read .env.local.

# LiveKit Cloud (browser test calls, agent dispatch)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Model providers (LLM, speech-to-text, voice, embeddings)
OPENAI_API_KEY=
# Optional speech providers an agent can pick (deepgram/nova-3, cartesia/sonic-3)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Local services (Docker Compose). Containers override the hosts with service names.
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio
POSTGRES_DB=studio
DATABASE_URL=postgresql+asyncpg://studio:studio@localhost:5432/studio
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=studio
S3_SECRET_KEY=studio-secret
S3_BUCKET=studio

# Shared secret the runtime sends to the API's /runtime endpoints (any long random string)
RUNTIME_API_TOKEN=
API_URL=http://localhost:8000
# Encrypts the secrets saved in the console (API keys tools send). Make one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=

# Console
NEXT_PUBLIC_API_URL=http://localhost:8000
